# Copy this file to `.env` and fill in values for the adapters you want to
# test. Never commit `.env`; it is ignored by git.

# Phoenix
PHX_HOST=localhost
PORT=4000
DATABASE_URL=ecto://postgres:postgres@localhost/jido_chat_ui_dev
SECRET_KEY_BASE=

# Jidoka / Jido.AI room agents
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REACT_TOKEN_SECRET=

# GitHub adapter
# Fine-grained PAT or GitHub App installation token with Issues: write.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Format: owner/repo#issue_number. Use a disposable issue for live testing.
GITHUB_TEST_ISSUE=agentjido/jido_chat_ui#1

# Slack adapter
# Bot token from Slack OAuth & Permissions.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional app-level token for Socket Mode (`xapp-...`).
SLACK_APP_TOKEN=
# Channel and user ids used when sending live test traffic.
SLACK_TEST_CHANNEL_ID=
SLACK_TEST_USER_ID=
SLACK_TEST_REACTION=wave

# Telegram adapter
TELEGRAM_BOT_TOKEN=
# Chat id used for live messages. Can be a user, group, supergroup, or channel.
TELEGRAM_TEST_CHAT_ID=
# Optional forum topic/thread support.
TELEGRAM_TEST_FORUM_CHAT_ID=
TELEGRAM_TEST_THREAD_ID=
TELEGRAM_TEST_REACTION=
TELEGRAM_TEST_PHOTO_REF=https://httpbin.org/image/png
TELEGRAM_TEST_DOCUMENT_REF=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

# Discord adapter
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_TEST_CHANNEL_ID=
DISCORD_TEST_USER_ID=
DISCORD_TEST_REACTION=

# Mattermost adapter
# The adapter repo currently uses MATTERMOST_URL in tests and examples; keep
# MATTERMOST_BASE_URL as a UI-friendly alias for future bridge config.
MATTERMOST_URL=
MATTERMOST_BASE_URL=
MATTERMOST_TOKEN=
MATTERMOST_BOT_TOKEN=
MATTERMOST_TEAM_ID=
MATTERMOST_CHANNEL_ID=

# X / Twitter adapter
# OAuth 1.0a user-context credentials for XDK Direct Messages.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_TEST_RECIPIENT_ID=
X_TEST_CONVERSATION_ID=
X_WEBHOOK_ID=
X_WEBHOOK_URL=
X_WEBHOOK_ENV_NAME=
# Optional compatibility alias for Account Activity CRC/signature checks.
SECRET_KEY=

# Live test toggles. Keep these false unless you are intentionally sending real
# messages or comments through the target platform.
RUN_LIVE_GITHUB_TESTS=false
RUN_LIVE_SLACK_TESTS=false
RUN_LIVE_TELEGRAM_TESTS=false
RUN_LIVE_DISCORD_TESTS=false
RUN_LIVE_X_TESTS=false
RUN_LIVE_X_SEND_TESTS=false

# Optional Signal setup:
# Signal is intentionally not included in mix.exs by default because it requires
# signal-cli and a registered local Signal account.
# Add `{:jido_chat_signal, github: "agentjido/jido_chat_signal", branch: "main"}`
# before enabling these.
# RUN_LIVE_SIGNAL_TESTS=false
# SIGNAL_TRANSPORT=cli
# SIGNAL_RPC_ENDPOINT=http://127.0.0.1:8080/api/v1/rpc
# SIGNAL_ACCOUNT=
# SIGNAL_TEST_RECIPIENT=
# SIGNAL_INGRESS_MODE=rpc_polling
# SIGNAL_RECEIVE_TIMEOUT_S=1
# SIGNAL_RECEIVE_MAX_MESSAGES=10
